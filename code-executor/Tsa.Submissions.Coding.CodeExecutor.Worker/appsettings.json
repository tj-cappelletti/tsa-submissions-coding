{
  "KubernetesCluster": {
    "Namespace": "coding",
    "JobTimeoutMinutes": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RunnerImageRegistry": {
    "RegistryUri": "",
    "ImageName": "code-executor-runner",
    "ImageVersion": "latest",
    "LanguageTags": {
      "C": "clang",
      "Cpp": "gcc",
      "CSharp": "dotnet",
      "FSharp": "dotnet",
      "Go": "go",
      "Java": "java",
      "NodeJs": "nodejs",
      "Python": "python",
      "Ruby": "ruby",
      "VisualBasic": "dotnet"
    }
  },
  "RabbitMQ": {
    "HostName": "rabbitmq.tsa.localdev.me",
    "Port": "5672",
    "QueueName": "tsa_submissions_coding",
    "UserName": "coding"
  },
  "ScorerImageRegistry": {
      "RegistryUri": "",
      "ImageName": "code-executor-scorer",
      "ImageVersion": "latest"
    },
    "SubmissionsApi": {
      "BaseUrl": "http://api.tsa.localdev.me:5000",
      "Authentication": {
        "Username": "system"
      }
    }
